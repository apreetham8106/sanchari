
# ==========================================
# Java / Maven
# ==========================================

# Maven build output - root and nested projects
target/
**/target/

# Compiled Java files
*.class

# Java packaged artifacts
*.jar
*.war
*.ear

# Other Java build output
bin/
out/
build/

# Maven wrapper
# Keep mvnw, mvnw.cmd and .mvn/wrapper/maven-wrapper.properties

# ==========================================
# Spring Boot / Logs
# ==========================================

logs/
**/logs/

*.log
*.log.*
spring.log

# ==========================================
# Environment and Secrets
# ==========================================

.env
.env.*
!.env.example

application-local.properties
application-dev-local.properties
application-prod-local.properties

secrets/

*.pem
*.key
*.p12
*.jks

