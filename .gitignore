
# ==========================================
# Java / Maven
# ==========================================
target/
*.class
*.jar
*.war
*.ear

# Maven wrapper - keep wrapper scripts and properties
# (Do not ignore mvnw, mvnw.cmd or .mvn/wrapper/maven-wrapper.properties)

# ==========================================
# Spring Boot / Logs
# ==========================================
logs/
*.log
*.log.*
spring.log

# ==========================================
# Environment and Secrets
# ==========================================
.env
.env.*
!.env.example
application-local.properties
application-dev-local.properties
application-prod-local.properties
secrets/
*.pem
*.key
*.p12
*.jks

# ==========================================
# Angular / Node
# ==========================================
node_modules/
dist/
.angular/
.nx/
coverage/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ==========================================
# IDE
# ==========================================
.idea/
*.iml
.classpath
.project
.settings/
.factorypath
.springBeans
.sts4-cache/

# ==========================================
# VS Code
# ==========================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ==========================================
# OS generated files
# ==========================================
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ==========================================
# Temporary files
# ==========================================
*.tmp
*.temp
*.swp
*.bak
*.orig
*.old
*.cache

# ==========================================
# Test reports
# ==========================================
surefire-reports/
failsafe-reports/

# ==========================================
# Local database backups
# ==========================================
*.sql.gz
*.dump
*.backup
*.bak
